#!/usr/bin/env bash
# Native pre-commit hook (no framework needed). Install:  make hooks
# Skips any tool that isn't installed; the GitHub Actions CI runs the full set.
set -uo pipefail
root="$(git rev-parse --show-toplevel)"; cd "$root" || exit 1
fail=0
echo "▶ pre-commit checks"

# 1) never commit a real secrets file
# The .env/secrets.yaml pair is not the whole list any more. cloudflare/access.json carries real
# emails and account ids, ingress.yml the LAN map, homelab-private.json the tunnel credential, and
# the inventory/group_vars the real addresses — none of which gitleaks reliably flags, because only
# the tunnel credential looks like a high-entropy secret. A `git add -f` or a .gitignore slip was
# unguarded, in a PUBLIC repo. The *.example.* forms are the templates and stay allowed.
staged="$(git diff --cached --name-only)"
if printf '%s\n' "$staged" | grep -vE '\.example\.' \
   | grep -E '(^|/)\.env$|secrets\.yaml$|^cloudflare/(access\.json|ingress\.ya?ml|.*private.*\.json)$|^ansible/(inventory\.yml|group_vars/all\.yml)$|^tailscale/acl\.hujson$'; then
  echo "  ✖ refusing to commit a real-values file (the .example.* template is what belongs in git)"
  fail=1
fi

# 2) YAML lint (optional)
if command -v yamllint >/dev/null 2>&1; then
  yamllint . && echo "  ✓ yamllint" || fail=1
else
  echo "  • yamllint not installed — skipped"
fi

# 3) secret scan (optional)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner && echo "  ✓ gitleaks" || fail=1
else
  echo "  • gitleaks not installed — skipped (CI covers it)"
fi

if [ "$fail" = 0 ]; then echo "✔ all checks passed"; else echo "✘ checks failed — commit aborted"; fi
exit "$fail"
