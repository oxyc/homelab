# secrets — never commit
.env
docker/.env
**/secrets.yaml
*.key
*.pem

# ansible
ansible/inventory.yml
ansible/group_vars/all.yml
*.retry
.vault_pass

# proxmox unattended-install answer (has the hashed root pw)
proxmox/answer.toml

# tailnet ACL with your real login/CIDR (template is acl.hujson.example)
tailscale/acl.hujson

# docs / planning — kept local only
docs/

# reolink config snapshots (local)
.reolink-snapshots/

# local / editor
.DS_Store
*.swp
docker/atlas-data/

# Cloudflare private tunnel — real values and credentials (see cloudflare/*.example.*)
# Deny by pattern, allow the templates back. Listing the three filenames exactly meant a second
# tunnel's credential, a renamed config, or any new real file in here defaulted to TRACKED in a
# public repo — the wrong default for a directory whose entire contents are either a secret or a
# template of one.
cloudflare/*.json
cloudflare/*.yml
cloudflare/*.yaml
!cloudflare/*.example.json
!cloudflare/*.example.yml
