#!/usr/sbin/nft -f
# {{ ansible_managed }}
# Host control-plane lockdown (Debian + Incus). Replaces the old pve-firewall lockdown.
#
# Deliberately NO `flush ruleset`: that would wipe Incus/podman netfilter state on every
# load. The add/delete/recreate idiom below replaces ONLY our own table, atomically, so
# `nft -f` is idempotent and never touches anyone else's rules.
add table inet host_lockdown
delete table inet host_lockdown
table inet host_lockdown {
  chain input {
    type filter hook input priority 0; policy accept;

    iif "lo" accept
    ct state established,related accept

    # Trusted admin sources — full access. `tailscale0` is always allowed so a
    # bad rule (or the Punta Ballena move) can never lock you out.
    iifname "tailscale0" accept
    ip saddr {{ firewall_tailscale_cidr | default('100.64.0.0/10') }} accept
    # Trusted management LAN(s). During the Montevideo->Punta Ballena move both
    # are listed; drop the Montevideo entry from firewall_mgmt_cidrs after the move.
{% for cidr in firewall_mgmt_cidrs %}
    ip saddr {{ cidr }} accept
{% endfor %}
    ip protocol icmp accept

    # Everyone else: the host's SSH control plane is closed. Guests are unaffected —
    # their exposure is segmented at the network layer (Omada VLANs), and Incus attaches
    # them straight to the LAN bridge, so their published ports are their own to expose.
    tcp dport 22 drop
  }
}
