// Tailscale tailnet policy for the homelab (single user, tailnet-only; no public ports).
// Paste into the admin console -> Access Controls. Uses the modern `grants` syntax.
{
  // Single-user tailnet: your own devices reach each other + the LAN subnet route the host
  // advertises (ts_advertise_routes). Approve that route once in the console's Machines view
  // (this policy intentionally has no autoApprovers — approval is manual/one-time).
  "grants": [
    {"src": ["*"], "dst": ["*"], "ip": ["*"]},
  ],

  // Tailscale SSH: your devices -> your own machines. "accept" = no re-auth prompt (free).
  // NOTE: a custom "checkPeriod" needs Tailscale Premium/Enterprise, so the only free choices are
  // "check" (identity re-auth, fixed 12h — can't be lengthened) or "accept" (no re-auth). For a
  // single-user, tailnet-only box, "accept" is the pragmatic pick; if a device is lost, revoke it
  // in the console. To restore the 12h identity re-auth instead, change "accept" -> "check".
  "ssh": [
    {
      "action": "accept",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"],
    },
  ],
}
