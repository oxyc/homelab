# Mosquitto MQTT broker — the bridge between Frigate (publishes detections) and HA (subscribes). This
# is the one HAOS "add-on" Frigate strictly needs; as a container it's ~15 MB. Host networking so it
# listens on the HA container's LAN IP:1883 (Frigate, in the camera container, connects to ha_ip:1883;
# HA reaches it on localhost). LAN-only + anonymous (not internet-exposed) — add mosquitto_passwd auth
# via mosquitto.conf if you ever want it.
[Unit]
Description=Mosquitto MQTT broker (Frigate <-> HA)

[Container]
Image=docker.io/library/eclipse-mosquitto:2
ContainerName=mosquitto
Network=host
Volume=/opt/homeassistant/mosquitto/mosquitto.conf:/mosquitto/config/mosquitto.conf:ro
Volume=/opt/homeassistant/mosquitto/data:/mosquitto/data
# Liveness: -E connects+subscribes+exits, so this passes only if the broker is actually accepting
# connections (catches a wedged-but-running broker). mosquitto_sub ships in the eclipse-mosquitto image.
HealthCmd=mosquitto_sub -t healthcheck -E
HealthInterval=30s
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
Restart=unless-stopped
# Backoff (avoid start-limit latch) + a stop budget so persistence (mosquitto.db) is written on a clean
# stop before SIGKILL (podman default 10s).
RestartSec=10
TimeoutStopSec=15

[Install]
WantedBy=default.target
