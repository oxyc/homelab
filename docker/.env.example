# Copy to docker/.env and fill in. Real values live in the Bitwarden note `homelab-env`.
#   bw get notes homelab-env > docker/.env

# --- Cameras (VLAN30 e.g. 192.168.30.x; password MUST be simple alphanumeric for Reolink) ---
FRIGATE_CX820_IP=192.168.x.x
FRIGATE_DOORBELL_IP=192.168.x.x
FRIGATE_CAM_USER=admin
FRIGATE_CAM_PASS=changeme

# --- Frigate ---
FRIGATE_MQTT_HOST=192.168.x.x         # HA Mosquitto add-on
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=changeme

# --- Image versions (pin for reproducibility; defaults used if unset) ---
FRIGATE_VERSION=stable
SCRYPTED_VERSION=latest
CADDY_VERSION=2
DEN_REEL_VERSION=latest               # ghcr.io/oxyc/den-reel (profile: trailers) — Rust trailer addon+proxy
DEN_SCOUT_VERSION=latest              # ghcr.io/oxyc/den-scout (profile: scout)
DEN_ATLAS_VERSION=latest              # ghcr.io/oxyc/den-atlas (profile: atlas; mount dataset at ./atlas-data)
DEN_SUBTITLES_VERSION=latest          # ghcr.io/oxyc/den-subtitles (profile: subtitles) — Rust subs addon
DEN_EMBED_VERSION=latest              # ghcr.io/oxyc/den-embed (profile: embed) — bge-m3 embedder for atlas search
# DEN_EMBED_URL=http://den-embed:8080 # set on den-atlas to enable semantic search (needs the embed profile up)

# --- Sealed config-in-URL (den-scout/docs/SEALED-CONFIG.md) ------------------------------------------
# With a *_CONFIG_KEY set, each addon's /configure seals the user's BYOK secret INTO the install URL
# (crypto_box_seal) instead of plaintext base64 — the key is never readable in the URL and never stored
# server-side. Unset = sealing off, the addon still serves legacy plaintext URLs (safe to roll out).
# Generate one per addon:   head -c 32 /dev/urandom | base64
# BACK THESE UP (this .env is the only copy — losing a key makes every URL sealed to it undecryptable).
# *_CONFIG_KEYS_PREV = comma-separated PRIOR keys; leave empty until you rotate. To rotate: move the
# current key into *_KEYS_PREV, put a fresh key in *_CONFIG_KEY, redeploy — old sealed URLs keep working.
# Optional — uncomment + set only if you want sealing on (leave commented = legacy plaintext URLs):
# SCOUT_CONFIG_KEY=changeme           # den-scout: seals the debrid token
# SCOUT_CONFIG_KEYS_PREV=
# SUBS_CONFIG_KEY=changeme            # den-subtitles: seals the OpenSubtitles + LLM keys
# SUBS_CONFIG_KEYS_PREV=
# REEL_CONFIG_KEY=changeme            # den-reel: seals the TMDB (+ optional KinoCheck) key
# REEL_CONFIG_KEYS_PREV=

# --- Den trailers (profile: trailers) ---
# MIGRATION FALLBACK only: used when a request carries no per-install config. Once every install is
# re-added with a sealed /configure URL (which carries the user's own TMDB key), remove these two.
# TMDB_KEY=changeme                   # legacy server-side themoviedb.org API key (v3)
# KINOCHECK_KEY=changeme              # optional: trailer-discovery fallback when TMDB has none
# REEL_CACHE_MAX_BYTES=3221225472     # den-reel LRU trailer-cache cap (default 3GB here; upstream default is 8GB)

# --- Den Scout (profile: scout) — the debrid token rides in the per-install addon URL, sealed above ---
# SCOUT_SCRAPE_TIMEOUT_MS=8000        # per-indexer scrape timeout
# SCOUT_LIST_TTL_SECONDS=300          # how long a ranked stream list is cached
# SCOUT_MEDIAFUSION_URL=              # optional: self-hosted MediaFusion base incl. its config segment

# --- Caddy / HTTPS (wildcard *.{CADDY_LOCAL_DOMAIN} via Cloudflare DNS-01) ---
CADDY_LOCAL_DOMAIN=h.example.com       # your homelab subdomain (real value stays in .env)
ACME_EMAIL=you@example.com
CLOUDFLARE_API_TOKEN=changeme          # scoped: Zone:DNS:Edit on your zone only (Bitwarden)
HAOS_IP=192.168.x.x                    # Home Assistant VM  -> ha.<domain>
PROXMOX_IP=192.168.x.x                 # Proxmox host       -> pve.<domain> (also <host>:8006)
SCRYPTED_HOST=192.168.x.x              # Docker LXC IP      -> scrypted.<domain> (homekit only)
# CLOUDFLARE_API_TOKEN=...             # only if using DNS-01 for real certs

# --- restic / Cloudflare R2 (S3-compatible; free tier 10GB, no egress) ---
# NOTE: the AWS_* names are just the S3 standard restic uses for ANY S3 provider.
# These hold your CLOUDFLARE R2 token — nothing goes to Amazon.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/your-bucket
RESTIC_PASSWORD=changeme              # client-side encryption key (KEEP THIS in Bitwarden)
AWS_ACCESS_KEY_ID=changeme            # = your R2 token's Access Key ID  (not Amazon)
AWS_SECRET_ACCESS_KEY=changeme        # = your R2 token's Secret Access Key (not Amazon)

# --- SMB share for HA backups (HA writes here -> restic ships to R2) ---
SMB_PASSWORD=changeme                 # password for the 'habackup' share user

# --- Cloudflare Tunnel (optional: browser/family access to HA, gated by Access) ---
# Zero Trust dashboard: create a tunnel, map a public hostname -> http://<HAOS_IP>:8123,
# add an Access policy (email OTP). Paste the tunnel token here. Run: make tunnel / profile tunnel.
TUNNEL_TOKEN=changeme

# --- Ansible (read via env: `set -a; . docker/.env; set +a` before make deploy) ---
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx     # Tailscale host join — use a SINGLE-USE key
PVE_PASSWORD=changeme                  # Proxmox root password (for the PVE API modules)

# --- External dead-man's switch (optional) ---
# healthchecks.io ping URL. The host pings it every 15 min; if the box/internet dies, the
# pings stop and healthchecks.io alerts you. Leave unset/commented to skip the whole thing.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here
