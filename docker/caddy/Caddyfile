# Reverse proxy with a wildcard cert for *.${CADDY_LOCAL_DOMAIN} via Cloudflare DNS-01.
# The real domain lives only in .env (CADDY_LOCAL_DOMAIN) — never hardcoded here.
# Names resolve to private IPs (local DNS + Tailscale split-DNS); nothing is exposed.
# Proxmox is also reachable directly as https://<host>:8006 (Tailscale MagicDNS).
{
	email {$ACME_EMAIL}
}

*.{$CADDY_LOCAL_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	@ha host ha.{$CADDY_LOCAL_DOMAIN}
	handle @ha {
		reverse_proxy {$HAOS_IP}:8123
	}

	@frigate host frigate.{$CADDY_LOCAL_DOMAIN}
	handle @frigate {
		reverse_proxy frigate:5000
	}

	@scrypted host scrypted.{$CADDY_LOCAL_DOMAIN}
	handle @scrypted {
		# Scrypted is host-networked; set SCRYPTED_HOST to the LXC IP when homekit is on.
		reverse_proxy https://{$SCRYPTED_HOST}:10443 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	@trailers host trailers.{$CADDY_LOCAL_DOMAIN}
	handle @trailers {
		# Den trailer-service (compose --profile trailers). LAN-only; no auth needed
		# since it's never exposed. Same compose network, so resolve by service name.
		reverse_proxy trailer-service:8092
	}

	@scout host scout.{$CADDY_LOCAL_DOMAIN}
	handle @scout {
		# Den Scout (compose --profile scout). Reverse-proxied over https with a real wildcard cert so
		# Den's https-only addon check passes. Caddy forwards Host + X-Forwarded-Proto, so Scout builds
		# correct https://scout.<domain>/play/... URLs. Same compose network → resolve by service name.
		# Compress the JSON/HTML responses here (offloads it from Node); the 302 /play has no body.
		encode zstd gzip
		reverse_proxy den-scout:8080
	}

	@atlas host atlas.{$CADDY_LOCAL_DOMAIN}
	handle @atlas {
		# Den Atlas (compose --profile atlas). LAN-only dataset addon; same compose network,
		# resolve by service name. Blob URLs derive from the forwarded Host/proto. Gzip the JSON
		# labels (~11MB → far less on the wire); the .bin vectors are already compact int8.
		encode zstd gzip
		reverse_proxy den-atlas:8080
	}

	@pve host pve.{$CADDY_LOCAL_DOMAIN}
	handle @pve {
		reverse_proxy https://{$PROXMOX_IP}:8006 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	handle {
		abort
	}
}
