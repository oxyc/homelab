# Scrypted — HomeKit / HKSV bridge. OFF by default: the provisioner only installs this unit when
# COMPOSE_PROFILES includes `homekit` (the podman equivalent of the old compose `profiles: [homekit]`).
# Host networking is required for HomeKit/HKSV mDNS on the LAN (the Incus container is LAN-bridged).
# iGPU is used for the HEVC->H.264 transcode Apple requires (only when serving the full-res stream).
[Unit]
Description=Scrypted (HomeKit / HKSV)

[Container]
Image=ghcr.io/koush/scrypted:latest
ContainerName=scrypted
Network=host
AddDevice=/dev/dri
# HomeKit pairings live here (deliberately NOT backed up — re-pair on disaster, per docs/decisions.md).
Volume=/opt/homelab/scrypted:/server/volume
AutoUpdate=registry

[Service]
Restart=unless-stopped
# Backoff (avoid start-limit latch) + graceful stop. NOTE: scrypted carries AutoUpdate=registry on
# :latest but has NO HealthCmd here, so podman-auto-update can only roll back a hard START failure, not
# a wedged-but-running update. Before relying on it, add a HealthCmd (e.g. curl -k https://127.0.0.1:10443)
# once the in-image probe tool + port are confirmed, plus Notify=healthy. Low urgency: OFF by default
# (homekit profile) and its state is declared disposable (re-pair on disaster).
RestartSec=10
TimeoutStopSec=15

[Install]
WantedBy=default.target
