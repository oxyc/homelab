# Frigate NVR — 2 cameras. Records H.265 raw (copy, no transcode); detection + decode per config.yml.
# iGPU (/dev/dri) is used for vaapi decode of the detect streams, and for OpenVINO detection IF
# config.yml's detector is set to `openvino` (default there is `cpu` — see the detector note in
# docs/decisions.md). Recordings go to /mnt/nvr (the Incus 'nvr' disk device, on the 2TB NVMe).
[Unit]
Description=Frigate NVR
After=cameras-network.service
Wants=cameras-network.service

[Container]
Image=ghcr.io/blakeblackshear/frigate:stable
ContainerName=frigate
Network=cameras.network
EnvironmentFile=/opt/homelab/.env
AddDevice=/dev/dri
ShmSize=256m
# Recording-segment cache in RAM, NOT on the container overlay (which lives on the SATA SSD via the
# lvm-thin pool). Frigate buffers every segment here before moving it to the NVMe; on-disk that would be
# continuous SSD write churn. tmpfs caps at 1G but only uses RAM for what's actually buffered (~16G total).
Tmpfs=/tmp/cache:size=1000000000
# Config + Frigate's own state (db, model cache) live on the host bind for easy backup; config.yml is
# synced there by the provisioner. Recordings are the separate NVMe mount.
Volume=/opt/homelab/frigate:/config
Volume=/mnt/nvr:/media/frigate
PublishPort=5000:5000
PublishPort=8554:8554
PublishPort=8555:8555/tcp
PublishPort=8555:8555/udp
AutoUpdate=registry
# Liveness + auto-update rollback. Notify=healthy makes systemd treat the service "started" only once
# the API answers, so a bad :stable that starts-but-wedges never satisfies start -> podman-auto-update
# rolls it back. HealthOnFailure=kill cycles a container that goes unhealthy at RUNTIME (the wedged-but-
# "active" gap). curl is in the frigate image (its own upstream healthcheck uses it). StartPeriod covers
# the slow first boot (model load) so boot doesn't count as unhealthy.
HealthCmd=curl -fsS http://127.0.0.1:5000/api/version
HealthInterval=30s
HealthStartPeriod=120s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=unless-stopped
# RestartSec spaces restarts past systemd's default 5-in-10s StartLimit so a boot-race crash-loop
# doesn't latch the unit OFF (this box hard-crashes often). TimeoutStartSec must exceed time-to-healthy
# now that Notify=healthy gates readiness. TimeoutStopSec lets go2rtc + the ffmpeg muxers close streams
# (podman default is 10s -> SIGKILL).
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=default.target
